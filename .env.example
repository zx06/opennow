# --- 本地单二进制黄金路径（复制为 .env 后按需 source / 交给进程管理器）---
OPENNOW_ADDR=:8080
OPENNOW_DATA_DIR=./data
OPENNOW_STORAGE=local
OPENNOW_API_KEY=change-me
OPENNOW_PUBLIC_URL=http://127.0.0.1:8080

# --- 可选：管理后台 GitHub OAuth（不配则后台用 API Key）---
# OPENNOW_GITHUB_CLIENT_ID=
# OPENNOW_GITHUB_CLIENT_SECRET=
# OPENNOW_GITHUB_ALLOWLIST=zx06
# OPENNOW_GITHUB_DENY_MESSAGE=
# OPENNOW_ADMIN_API_KEY_LOGIN=true

# --- 可选：子域名 / 签名 ---
# OPENNOW_BASE_DOMAIN=
# OPENNOW_SECRET=
# OPENNOW_ADMIN_PREFIX=/_admin/

# --- 出网（OAuth / 远程存储）：使用标准代理变量，无需额外库 ---
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1

# --- 可选：用 GHCR 镜像代替本地二进制 ---
# docker pull ghcr.io/zx06/opennow:latest
# docker run --rm -p 8080:8080 --env-file .env -v opennow-data:/data ghcr.io/zx06/opennow:latest
